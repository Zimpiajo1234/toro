1 = zona menta + caja azul     2 = zona azul + caja menta     3 = zona amarillo + caja lavanda
4 = zona lavanda + caja amarillo                              5 = zona amarillo + caja lavanda
6 = zona lavanda + caja amarillo                              7 = zona amarillo + caja lavanda
8 = zona lavanda               9 = zona coral + caja coral
a = caja amarillo
H = estantería 3 alturas
