1 = zona azul        2 = zona coral       3 = zona menta       4 = zona amarillo    5 = zona lavanda
6 = zona azul        7 = zona amarillo    8 = zona menta       9 = zona coral
a = caja amarillo    b = caja coral       c = caja lavanda     d e = caja menta
f = caja amarillo    g = caja azul        h = caja coral       i = caja azul
