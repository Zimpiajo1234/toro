1 = zona azul + caja menta     2 = zona menta + caja amarillo
3 = zona amarillo + caja coral                                4 = zona menta + caja menta
5 = zona amarillo + caja amarillo                             6 = zona azul + caja azul
7 = zona coral + caja azul     8 = zona lavanda + caja lavanda
